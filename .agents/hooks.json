{
  "pulso-approval-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/pre-tool-approval.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
